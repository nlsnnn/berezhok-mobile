# API Configuration
API_BASE_URL=http://localhost:8080/v1
CHAT_BASE_URL=http://localhost:8090
# dev: ws://localhost:8090/ws   prod: wss://fooday.live/chat-ws
CHAT_WS_BASE_URL=ws://localhost:8090/ws

# Mock API toggle (true = use mock, false = use real API)
USE_MOCK_API=false

# Environment (dev/prod)
FLUTTER_ENV=dev

# Push notifications (requires Firebase config files when enabled)
ENABLE_PUSH_NOTIFICATIONS=false
